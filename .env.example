# Copy to .env.local only when overriding local defaults.
APP_ORIGIN=http://127.0.0.1:3000
# Without DATABASE_URL, the API uses embedded PostgreSQL at .data/postgres.
# DATABASE_URL=postgresql://football:football@127.0.0.1:5432/football_idle
# Set to 1 only with external PostgreSQL and a separately running worker.
EXTERNAL_WORKER=0
# God mode is available only with embedded PostgreSQL outside production.
# Return to Normal in the game before disabling these controls.
ENABLE_GOD_MODE=1
