{
  "name": "football-idle-mmo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:catalog": "node --import tsx scripts/audit-catalog.mjs",
    "lint": "prettier --check \"apps/server/**/*.ts\" \"apps/web/app/**/*.{ts,tsx,css}\" \"packages/**/*.ts\" \"scripts/*.mjs\" \"tests/*.ts\" \"*.json\" \".github/**/*.{yml,md}\"",
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev apps/web --hostname 127.0.0.1 --port 3000",
    "dev:api": "tsx apps/server/src/main.ts",
    "worker": "tsx apps/server/src/worker.ts",
    "build": "next build apps/web",
    "build:check": "node scripts/check-build.mjs",
    "start:web": "next start apps/web --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "10.3.0",
    "fastify": "5.12.7",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
